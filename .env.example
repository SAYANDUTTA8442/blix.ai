# ============================================================
# Blix v0.2 — Environment Configuration
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# LLM Provider
# ----------------------------------------------------------

# Which provider to use: "transformers" (default) or "ollama"
BLIX_LLM_PROVIDER=transformers

# HuggingFace model for the chat LLM (TransformersProvider)
# Any causal-LM on HuggingFace Hub works here.
BLIX_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Ollama model tag (only used when BLIX_LLM_PROVIDER=ollama)
BLIX_OLLAMA_MODEL=llama3.2

# Generation params
BLIX_TEMPERATURE=0.7
BLIX_MAX_NEW_TOKENS=512

# ----------------------------------------------------------
# Embeddings (Semantic Retrieval)
# ----------------------------------------------------------

# sentence-transformers model for semantic memory retrieval
# Downloads once (~22 MB), then cached in ~/.cache/huggingface
BLIX_EMBED_MODEL=all-MiniLM-L6-v2

# Cosine similarity threshold for semantic retrieval (0.0 – 1.0)
BLIX_SEMANTIC_THRESHOLD=0.35

# Top-k results from semantic search
BLIX_SEMANTIC_TOP_K=5

# ----------------------------------------------------------
# Memory extraction (Chain-of-Thought)
# ----------------------------------------------------------

# Whether to auto-extract memories after each turn
BLIX_AUTO_EXTRACT=true

# ----------------------------------------------------------
# HuggingFace Hub
# ----------------------------------------------------------

# Optional: your HuggingFace token (needed for private/gated models)
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Set to 1 to force offline mode (use only cached models)
TRANSFORMERS_OFFLINE=0
